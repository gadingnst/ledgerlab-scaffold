{
  "name": "ledgerlab",
  "version": "0.1.0",
  "private": true,
  "description": "Technical test scaffold: accounting SaaS with a dashboard, a double-entry ledger service, and a reporting service.",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ai:log": "node scripts/log-ai-prompt.mjs",
    "ai:verify": "node scripts/verify-ai-log.mjs",
    "guide:pdf": "node scripts/build-guide.mjs",
    "guide:html": "node scripts/build-guide.mjs --html-only",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:seed": "./scripts/seed-db.sh",
    "deploy:k8s": "./deployment/deploy-k8s.sh",
    "db:drill": "./scripts/restore-drill.sh",
    "load:test": "node scripts/load-test.mjs"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/node": "^22.13.1",
    "autocannon": "^8.0.0",
    "marked": "^18.0.14",
    "prettier": "^3.4.2",
    "turbo": "^2.4.0",
    "typescript": "^5.7.3"
  }
}
