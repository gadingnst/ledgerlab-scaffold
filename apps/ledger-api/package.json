{
  "name": "@ledgerlab/ledger-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup && tsc --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:challenges": "vitest run --config vitest.challenges.config.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@ledgerlab/db": "workspace:*",
    "@ledgerlab/shared": "workspace:*",
    "hono": "^4.6.16",
    "zod": "^3.24.1",
    "@ledgerlab/rate-limit": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
