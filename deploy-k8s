#!/bin/bash

# ==============================================================================
# deploy-k8s
# Unified Kubernetes Deployment CLI for LedgerLab on K3s Homelab
# Uses centralized Homelab Sandbox Postgres on 10.18.1.103:5433
# Usage: ./deploy-k8s [all|migrate|ledger-api|reporting-api|web]
# ==============================================================================

set -e

export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && \. "/opt/homebrew/opt/nvm/nvm.sh"
[ -f "$HOME/.kube/config-nouverse" ] && export KUBECONFIG="${KUBECONFIG:-$HOME/.kube/config-nouverse}"

NAMESPACE="ledgerlab"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$SCRIPT_DIR"
cd "$ROOT_DIR" || exit 1

APP="${1:-}"
ALLOWED_APPS=("all" "migrate" "ledger-api" "reporting-api" "web")

is_allowed=false
for allowed in "${ALLOWED_APPS[@]}"; do
  if [ "$APP" = "$allowed" ]; then
    is_allowed=true
    break
  fi
done

if [ "$is_allowed" = "false" ]; then
  echo "❌ Error: Invalid app target '$APP'."
  echo "Usage: ./deploy-k8s [all|migrate|ledger-api|reporting-api|web]"
  exit 1
fi

# ------------------------------------------------------------------------------
# 1. Load Environment Configuration
# ------------------------------------------------------------------------------
load_env() {
  local env_file=""
  if [ -f ".env.prod" ]; then
    env_file=".env.prod"
  elif [ -f ".env" ]; then
    env_file=".env"
  elif [ -f ".env.production" ]; then
    env_file=".env.production"
  fi

  if [ -f "$env_file" ]; then
    echo "📋 Loading environment configuration from $env_file..."
    while IFS='=' read -r key val || [ -n "$key" ]; do
      key="$(echo "$key" | tr -d '[:space:]')"
      [[ "$key" =~ ^#.*$ ]] && continue
      [ -z "$key" ] && continue
      val="${val%\"}"; val="${val#\"}"
      val="${val%\'}"; val="${val#\'}"
      export "$key=$val"
    done < "$env_file"
  else
    echo "⚠️  No .env file found. Using homelab cluster defaults."
  fi

  # Defaults (Homelab Sandbox Postgres on LXC 103:5433)
  INTERNAL_API_TOKEN="${INTERNAL_API_TOKEN:-dev-internal-token}"
  LEDGER_API_DOMAIN="${LEDGER_API_DOMAIN:-ledger-api.gading.dev}"
  REPORTING_API_DOMAIN="${REPORTING_API_DOMAIN:-reporting-api.gading.dev}"
  WEB_DOMAIN="${WEB_DOMAIN:-ledgerlab.gading.dev}"
  CORS_ORIGINS="${CORS_ORIGINS:-https://${WEB_DOMAIN}}"
  DATABASE_URL="${DATABASE_URL:-postgres://ledgerlab:ledgerlab@10.18.1.103:5433/ledgerlab}"
  VITE_LEDGER_API_URL="${VITE_LEDGER_API_URL:-https://${LEDGER_API_DOMAIN}}"
  VITE_REPORTING_API_URL="${VITE_REPORTING_API_URL:-https://${REPORTING_API_DOMAIN}}"
}

# ------------------------------------------------------------------------------
# 2. Synchronize Namespace & Secrets
# ------------------------------------------------------------------------------
sync_secrets() {
  echo "🔐 Synchronizing namespace and secrets for '$NAMESPACE'..."
  kubectl apply -f deployment/k8s/namespace.yaml > /dev/null

  kubectl create secret generic ledgerlab-secrets \
    --namespace "$NAMESPACE" \
    --from-literal=DATABASE_URL="$DATABASE_URL" \
    --from-literal=INTERNAL_API_TOKEN="$INTERNAL_API_TOKEN" \
    --from-literal=CORS_ORIGINS="$CORS_ORIGINS" \
    --dry-run=client -o yaml | kubectl apply -f - > /dev/null
  echo "   ✅ Secrets synced (DATABASE_URL pointed to sandbox postgres:5433)."
}

# ------------------------------------------------------------------------------
# 3. Build & Distribute Image
# ------------------------------------------------------------------------------
build_and_distribute() {
  local target="$1"
  local image_name="$2"
  shift 2
  local build_args=("$@")

  echo ""
  echo "📦 [1/3] Building image '$image_name' (target: $target, platform: linux/amd64)..."
  docker build \
    --platform linux/amd64 \
    --target "$target" \
    -t "$image_name" \
    "${build_args[@]}" \
    .

  echo "💾 [2/3] Exporting and distributing image to K3s worker nodes..."
  local clean_name
  clean_name="$(echo "$image_name" | tr '/:' '-')"
  local tar_file="/tmp/${clean_name}.tar"
  docker save "$image_name" -o "$tar_file"

  echo "   -> Transferring via hub.nouverse to worker nodes (10.18.1.111, 10.18.1.112)..."
  scp -q "$tar_file" "hub.nouverse:$tar_file"
  ssh hub.nouverse "
    for worker in 10.18.1.111 10.18.1.112; do
      echo '      importing to worker '\$worker'...';
      scp -q -o StrictHostKeyChecking=no '$tar_file' 'ubuntu@\${worker}:$tar_file';
      ssh -o StrictHostKeyChecking=no 'ubuntu@\${worker}' 'sudo /usr/local/bin/k3s ctr --namespace k8s.io images import $tar_file && sudo rm -f $tar_file' > /dev/null;
    done;
    rm -f '$tar_file'
  "
  rm -f "$tar_file"
  echo "   ✅ Image distributed to cluster containerd runtime."
}

# ------------------------------------------------------------------------------
# App Deployers
# ------------------------------------------------------------------------------
deploy_migrate() {
  echo ""
  echo "🔄 Running database migration job on sandbox postgres (5433)..."
  build_and_distribute "tools" "ledgerlab/tools:latest"
  kubectl delete job ledgerlab-migrate -n "$NAMESPACE" --ignore-not-found > /dev/null 2>&1 || true
  kubectl apply -f deployment/k8s/migrate-job.yaml
  echo "   Waiting for migration job completion..."
  kubectl wait --for=condition=complete job/ledgerlab-migrate -n "$NAMESPACE" --timeout=90s
  echo "✅ Database migration complete."
}

deploy_ledger_api() {
  echo ""
  echo "🚀 Deploying ledger-api (target: https://${LEDGER_API_DOMAIN})..."
  build_and_distribute "ledger-api" "ledgerlab/ledger-api:latest"
  kubectl apply -f deployment/k8s/ledger-api.yaml
  echo "   Waiting for ledger-api rollout..."
  kubectl rollout status deployment/ledger-api -n "$NAMESPACE" --timeout=90s
  echo "✅ ledger-api deployed successfully at https://${LEDGER_API_DOMAIN}"
}

deploy_reporting_api() {
  echo ""
  echo "🚀 Deploying reporting-api (target: https://${REPORTING_API_DOMAIN})..."
  build_and_distribute "reporting-api" "ledgerlab/reporting-api:latest"
  kubectl apply -f deployment/k8s/reporting-api.yaml
  echo "   Waiting for reporting-api rollout..."
  kubectl rollout status deployment/reporting-api -n "$NAMESPACE" --timeout=90s
  echo "✅ reporting-api deployed successfully at https://${REPORTING_API_DOMAIN}"
}

deploy_web() {
  echo ""
  echo "🚀 Deploying web dashboard (target: https://${WEB_DOMAIN})..."
  build_and_distribute "web" "ledgerlab/web:latest" \
    --build-arg VITE_LEDGER_API_URL="$VITE_LEDGER_API_URL" \
    --build-arg VITE_REPORTING_API_URL="$VITE_REPORTING_API_URL"
  kubectl apply -f deployment/k8s/web.yaml
  echo "   Waiting for web dashboard rollout..."
  kubectl rollout status deployment/web -n "$NAMESPACE" --timeout=90s
  echo "✅ web dashboard deployed successfully at https://${WEB_DOMAIN}"
}

# ------------------------------------------------------------------------------
# Main Execution
# ------------------------------------------------------------------------------
load_env
sync_secrets

case "$APP" in
  "migrate")
    deploy_migrate
    ;;
  "ledger-api")
    deploy_ledger_api
    ;;
  "reporting-api")
    deploy_reporting_api
    ;;
  "web")
    deploy_web
    ;;
  "all")
    deploy_migrate
    deploy_ledger_api
    deploy_reporting_api
    deploy_web
    echo ""
    echo "🎉 Full LedgerLab stack deployed successfully to K3s!"
    echo "   Database:      Homelab Sandbox Postgres (10.18.1.103:5433)"
    echo "   Dashboard:     https://${WEB_DOMAIN}"
    echo "   Ledger API:    https://${LEDGER_API_DOMAIN}"
    echo "   Reporting API: https://${REPORTING_API_DOMAIN}"
    ;;
esac
